---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Hi, I’m Mouad.
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        I’m a software engineer from Morocco who builds backend systems with
        Java and Spring Boot. I enjoy creating scalable applications, exploring
        new technology, and contributing to open source.
      </p>
      <p class="mt-2">
        This is where I learn in public—sharing what works, what doesn’t, and
        the lessons I pick up along the way. My goal is to build useful things
        that solve real problems while continuously improving my craft.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section id="skills" class="border-border border-b py-12">
      <h2 class="text-2xl font-semibold tracking-wide">Skills</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="font-semibold">Backend</h3>
          <p class="text-muted-foreground mt-2">
            Java · Spring Boot · Spring Security · Spring Data JPA · REST APIs
          </p>
        </div>
        <div>
          <h3 class="font-semibold">Data</h3>
          <p class="text-muted-foreground mt-2">PostgreSQL · Redis · Flyway</p>
        </div>
        <div>
          <h3 class="font-semibold">Messaging &amp; Distributed Systems</h3>
          <p class="text-muted-foreground mt-2">RabbitMQ · WebSockets · SSE</p>
        </div>
        <div>
          <h3 class="font-semibold">Infrastructure</h3>
          <p class="text-muted-foreground mt-2">
            Docker · GitHub Actions · Nginx · Linux
          </p>
        </div>
        <div>
          <h3 class="font-semibold">Frontend</h3>
          <p class="text-muted-foreground mt-2">Angular · Tailwind CSS</p>
        </div>
      </div>
    </section>

    <section id="projects" class="border-border border-b py-12">
      <h2 class="text-2xl font-semibold tracking-wide">Projects</h2>
      <article class="mt-5">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="text-xl font-semibold">Fitness Scheduling Platform</h3>
          <a
            class="text-accent hover:underline"
            href="https://github.com/devcom33/Fitness-Booking-System"
            target="_blank"
            rel="noreferrer"
          >
            View on GitHub ↗
          </a>
        </div>
        <p class="mt-2">
          A full-stack fitness management platform that helps gyms and fitness
          studios manage clients, trainers, classes, schedules, bookings, and
          attendance from a centralized system.
        </p>
        <p class="mt-2">
          Built with Spring Boot, Angular, PostgreSQL, and JWT, the platform
          provides role-based access for administrators, trainers, and clients.
          It includes trainer approval workflows, session scheduling, booking
          validation, attendance tracking, and an administrative analytics
          dashboard.
        </p>
      </article>

      <article class="border-border mt-8 border-t pt-8">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="text-xl font-semibold">HabitFlow</h3>
          <a
            class="text-accent hover:underline"
            href="https://github.com/devcom33/HabitFlow"
            target="_blank"
            rel="noreferrer"
          >
            View on GitHub ↗
          </a>
        </div>
        <p class="mt-2 font-medium">Track. Improve. Transform.</p>
        <p class="mt-2">
          HabitFlow is an open-source habit tracker for developers who value a
          clean interface and meaningful data. Inspired by GitHub’s contribution
          graph, it makes daily routines visible through a satisfying progress
          grid—without the bloat.
        </p>
        <p class="mt-2">
          Built with React and Tailwind CSS on the frontend, plus a Spring Boot
          3.5 REST API, PostgreSQL, and Docker. It supports multiple habits,
          daily tracking, streaks, completion rates, and has earned 14 GitHub
          stars.
        </p>
      </article>

      <article class="border-border mt-8 border-t pt-8">
        <h3 class="text-xl font-semibold">Awalit</h3>
        <p class="mt-2 font-medium">AI Meeting Assistant</p>
        <p class="mt-2">
          Awalit is an AI-powered meeting assistant that automatically records,
          transcribes, and summarizes online meetings. It integrates with Google
          Meet, Drive, and Calendar to create a complete workflow automation
          experience.
        </p>
        <p class="mt-2">
          Built with a scalable microservices architecture, it uses
          Faster-Whisper for transcription, Pyannote.audio for speaker
          diarization, Gemini for AI-generated summaries, and PostgreSQL for
          secure data storage.
        </p>
      </article>
    </section>

    <section id="contact" class="border-border border-b py-12">
      <h2 class="text-2xl font-semibold tracking-wide">Get in touch</h2>
      <p class="mt-3">
        Have a project idea, a question, or just want to say hello? Find me on
        GitHub or X.
      </p>
      <div class="mt-5 flex flex-wrap gap-4">
        <a
          class="text-accent hover:underline"
          href="https://github.com/devcom33"
          target="_blank"
          rel="noreferrer"
        >
          GitHub ↗
        </a>
        <a
          class="text-accent hover:underline"
          href="https://x.com/mouaddev"
          target="_blank"
          rel="noreferrer"
        >
          X / @mouaddev ↗
        </a>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      (featuredPosts.length > 0 || recentPosts.length > 0) && (
        <div class="my-8 text-center">
          <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
